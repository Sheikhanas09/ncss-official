# Copy this file to .env.local and fill in both values.
# Find them in Supabase → Project Settings → API (Data API).
# On Vercel, add the same two values under Project → Settings → Environment Variables.

NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
# The "anon public" key (or the new "publishable" key). Safe to use in the browser.
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key
